# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# app data (local JSON store, usage log)
/.data/

# personal word data (import seed) — kept local, not published
/tracker.csv
/words.csv

# internal working docs — kept local, off the public repo
/CLAUDE.md
/AGENTS.md
/STATUS.md
/CHEATSHEET.md
/.claude/

# personal writing sources — real Google Doc links stay local, never committed
/content/writing/sources.local.json

# ingested writing questions & charts (personal / third-party) — only the built-in samples are committed
/content/writing/task1/prompts/*
!/content/writing/task1/prompts/sample-entertainment.json
/content/writing/task2/prompts/*
/public/writing/task1/*
!/public/writing/task1/sample-entertainment.svg

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real ones stay local; the example is committed as a config guide
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
temp_img/
