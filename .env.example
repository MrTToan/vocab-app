# Copy this file to .env.local and fill in the values you have.
# The app runs even with everything blank (local JSON storage, no AI).

# ─────────────────────────────────────────────────────────────
# LLM: enrichment + sentence scoring
# Two modes. See docs/SETUP-LLM-PROVIDERS.md for the full guide.
# ─────────────────────────────────────────────────────────────

# DEFAULT MODE (Anthropic). Leave LLM_MODE unset or "default".
# Uses Haiku 4.5 for enrichment, Sonnet 5 for scoring.
ANTHROPIC_API_KEY=

# CUSTOM — one provider. Any OpenAI-compatible API (OpenAI, OpenRouter, Groq,
# DeepSeek, Google Gemini's OpenAI endpoint, local Ollama, …) or Anthropic.
# LLM_MODE=custom
# LLM_PROVIDER=openai                       # "openai" (OpenAI-compatible) or "anthropic"
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1    # e.g. https://openrouter.ai/api/v1, http://localhost:11434/v1
# LLM_MODEL=gpt-4o-mini

# PRIORITY FALLBACK CHAIN — list providers in order; add as many as you want.
# The app uses #1; if it fails 3 times IN A ROW it permanently drops to #2, then
# #3, … (recovers only on restart). One global chain for all tasks.
# LLM_1_PROVIDER=openai
# LLM_1_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_1_API_KEY=...            LLM_1_MODEL=gemini-flash-latest
# LLM_2_PROVIDER=openai
# LLM_2_BASE_URL=https://api.openai.com/v1
# LLM_2_API_KEY=sk-...         LLM_2_MODEL=gpt-4o-mini
# LLM_3_PROVIDER=anthropic
# LLM_3_API_KEY=sk-ant-...     LLM_3_MODEL=claude-sonnet-5

# ─────────────────────────────────────────────────────────────
# Storage — pick ONE (or leave all blank for zero-setup local SQLite).
# ─────────────────────────────────────────────────────────────

# DEFAULT: local SQLite file at .data/lexi.db — nothing to set.
# To deploy on serverless (Vercel), point the SAME app at a hosted libSQL (Turso):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
# (A local file also works via DATABASE_URL=file:./.data/lexi.db)

# ALTERNATIVE: Google Sheet (so you can open your words in a spreadsheet).
# Set these and the app uses the Sheet instead of SQLite.
# See docs/SETUP-GOOGLE-SHEET.md
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
SHEET_ID=

# ─────────────────────────────────────────────────────────────
# Auth (multi-user deploy). Leave ALL blank to run single-user/local:
# with no AUTH_* set, every request is the local owner (dev seam).
# Set these to turn on Google sign-in + per-user data isolation.
# See docs/COOLIFY-DEPLOY.md (kept local). NextAuth v5 reads these by name.
# ─────────────────────────────────────────────────────────────
# AUTH_GOOGLE_ID=<google oauth client id>
# AUTH_GOOGLE_SECRET=<google oauth client secret>
# AUTH_SECRET=<openssl rand -base64 32>
# AUTH_URL=https://your-domain            # must equal the public HTTPS origin

# Per-user daily LLM caps (owner is exempt). Every route that reaches a model
# requires sign-in and is metered; on top there is a fixed burst limit of 12 LLM
# calls per user per minute. Defaults: 150 / 300 / 40 / 5 / 30 / 300.
# For a PUBLIC deploy keep these low — public users spend YOUR provider keys.
# QUOTA_ENRICH=20            # word enrichment (Add preview + import)
# QUOTA_SCORE=40             # practice answer scoring
# QUOTA_SCORE_WRITING=10     # essay scoring
# QUOTA_EXTRACT_CHART=3      # reading a Task 1 chart image (vision)
# QUOTA_DISCUSS=15           # "discuss this feedback" tutor turns
# QUOTA_GENERATE=200         # live exercise generation (over-cap falls back to local, never errors)
